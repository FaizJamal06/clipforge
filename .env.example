# ============================================
# ClipForge AI — Environment Variables
# ============================================
# Copy this file to backend/.env and fill in your values.

# ----- LLM Provider (Google Gemini, direct via langchain-google-genai) -----
LLM_API_KEY=your_google_ai_studio_key
LLM_MODEL=gemini-2.5-flash
LLM_MAX_RETRIES=3

# LLM rate limiting (Gemini free tier is 5 req/min — default of 4 leaves safety margin)
LLM_RATE_LIMIT_RPM=4
LLM_BATCH_SIZE=7

# ----- Database -----
# Defaults to a local SQLite file (backend/data/clipforge.db) if unset.
# Use a postgresql:// or postgresql+asyncpg:// URL in production.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipforge

# ----- Cache (Redis) -----
# Currently unused by the running app (see AUDIT.md) — reserved for upcoming
# shared rate-limiting/caching work.
REDIS_URL=redis://localhost:6379/0

# ----- Application -----
APP_NAME=ClipForge AI
DEBUG=true
API_VERSION=v1

# ----- Pipeline Configuration -----
MAX_VALIDATION_RETRIES=3
CLIP_MIN_DURATION=40
CLIP_MAX_DURATION=60
TOP_CLIPS_COUNT=3

# ----- CORS -----
CORS_ORIGINS=["http://localhost:3000"]

# ----- Transcript sourcing -----
# Supadata is the primary transcript source; the rest are fallbacks used if it's unset/fails.
SUPADATA_API_KEY=your_supadata_api_key
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
YOUTUBE_PROXY=http://user:pass@proxy.com:8080

# ----- Security -----
# API_KEYS is a JSON array of allowed keys; leave empty to disable API-key auth
# (the /process endpoints are then protected only by IP-based rate limiting).
API_KEYS=[]
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_BURST=5
